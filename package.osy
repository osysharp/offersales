// Osysharp.OfferSales — sell a few simple offers: a ticket, a day pass, a ten-visit card, a membership, a workshop seat.
// Online through any payment provider (Osysharp.Payments), by bank transfer or pay-at-the-desk marked received by
// staff, or across a counter — cash, a card terminal, a reader or a QR code. Every purchase recorded with what was paid
// for whom; the app told ONCE when it is paid and once per refund, so what was bought is handed over exactly once.
//
// ⚑ NOT A SHOP. Osysharp.Shop is the vertical for goods: a catalogue with variants and stock, a bag, VAT per line,
//   delivery and returns, with its own accounts. This is the small thing beside any app — a pool, a school, a venue —
//   that sells a handful of fixed-price offers to the people it already knows, and hands over what they bought.
// ⚑ WHAT WAS BOUGHT IS HANDED OVER BY WHOEVER LISTENS. `PurchasePaid` and `PurchaseRefunded` are the seam: the app
//   grants a pass, books a seat or sends a ticket. With Osysharp.PrepaidCredits or Osysharp.Memberships in the app, a
//   credit pack or a membership is an offer of its own and is granted — and taken back on a refund — by itself (the
//   bridges `Osysharp.OfferSales.PrepaidCredits` and `Osysharp.OfferSales.Memberships`).
// ⚑ THE APP SAYS WHO: `policy ManagesOffers => IsManager;` (offers and prices, refunds, the takings),
//   `policy SellsAtCounter => IsDesk;` (sells in person, marks a transfer received), and — when somebody buys for
//   somebody else — `policy BuysFor(Principal holder) => holder == user || ActsForDependant(holder);`.
package Osysharp.OfferSales {
  version     "1.0.0";
  minPlatform "0.14.0";
  summary     "sell a few simple offers — a ticket, a pass, a pack, a membership — online through any payment provider, by transfer or pay-at-the-desk marked received, or across a counter (cash, a card terminal, a reader or a QR code), for the buyer or somebody they buy for; prices, sale windows, limited places and a per-person limit; each purchase recorded with a receipt number, held while it is paid and lapsing when it is not; paid announced exactly once, refunds whole or in part announced once each; the day's takings by channel and method and a CSV — with an offers page, a buyer's purchases, a counter and an offers desk.";
  model "model/**/*.osy";
  use Osysharp.Identity@0;   // `Principal`: who buys, and who it is for
  use Osysharp.Payments@0;   // the provider contract every payment goes through
  use Osysharp.Csv@0;        // the takings' export
  use Osysharp.Storage;      // …written as a file to download
  use Osysharp.Ui;           // the pages
  use Osysharp.Workflow;     // each purchase's life: held while it is paid, lapsing when it is not
  tests "tests";
}
