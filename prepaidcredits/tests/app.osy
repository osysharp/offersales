// The producer's test project for Osysharp.OfferSales.PrepaidCredits — a pottery studio that sells a card of ten wheel
// sessions online and at its counter, and spends one per session.
app OfferSalesPrepaidCreditsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Identity@0;
  use Osysharp.Mail@0;
  use Osysharp.Sms@0;
  use Osysharp.EmailTemplates@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Payments@0;
  use Osysharp.OfferSales@0;
  use Osysharp.PrepaidCredits@0;
  // Osysharp.OfferSales.PrepaidCredits, the package under test, is not written: it arrives by itself because this app uses
  // OfferSales and PrepaidCredits, which it completes (`osy lock` includes it and says so).
  use Osysharp.Ui;
  use Osysharp.Workflow;
}
